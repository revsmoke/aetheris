  font-display: swap;
  src: url(https://fonts.gstatic.com/l/font?kit=q5uSsoa5M_tv7IihmnkabAReu49Y_Bo-HVKMBi6Ue6szfNeazINFRtNzfw&skey=929d48ffa46440d3&v=v28) format('woff');
