_Thu, 04 Sep 2025 17:33:07 GMTÒ/0yz_NSMutableDictionary£y{3\NSDictionaryZfont/woff2Ò/0~_NSHTTPURLResponse£€3_NSHTTPURLResponse]NSURLResponse␀␀␀␀$␀)␀2␀7␀I␀L␀b␀d␀␀–␀±␀Ó␀õ␀ø?Fhkn²µ·¹»½¿ÁÃÅÆÈÊÌÎÕİéëíïHMXagjs|~€‡š¬®°²´¶¸º¼¾ÀÂÄÆÈÊÜŞàâäæèêìîğòôöøúü	'+>]e{‰ÃÜêó#C^~„àèî¾ÃÙİêõú			&␀␀␀␀␀␀␀␀␀␀␀␀␀‚␀␀␀␀␀␀␀␀␀␀␀␀␀␀	4_Vhttps://fonts.gstatic.com/s/spacegrotesk/v22/V8mDoQDjQSkFtoMM3T6r8E7mPbF4C_k3HqU.woff2Õ6(78O‡A/* ============================================
   AETHERIS - Environmental Design Intelligence
   REDESIGNED: Smart Dock Layout System
   ============================================ */

/* CSS Variables - Design Tokens */
:root {
    /* Color Palette - Lighter for better visibility */
    --bg-primary: #1a1f2e;
    --bg-secondary: #232838;
    --bg-tertiary: #2d3444;
    --bg-glass: rgba(26, 31, 46, 0.75);
    --bg-glass-light: rgba(255, 255, 255, 0.05);
    
    /* Accents */
    --accent-solar: #f5a623;
    --accent-solar-glow: rgba(245, 166, 35, 0.3);
    --accent-air: #4fc3f7;
    --accent-air-glow: rgba(79, 195, 247, 0.3);
    --accent-pollen: #a78bfa;
    --accent-success: #4ade80;
    --accent-warning: #fbbf24;
    --accent-danger: #f87171;
    
    /* Text */
    --text-primary: #ffffff;
    --text-secondary: rgba(255, 255, 255, 0.7);
    --text-tertiary: rgba(255, 255, 255, 0.5);
    --text-muted: rgba(255, 255, 255, 0.35);
    
    /* Typography */
    --font-display: 'Crimson Pro', Georgia, serif;
    --font-body: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
    
    /* Spacing */
    --space-xs: 0.25rem;
    --space-sm: 0.5rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2rem;
    --header-height: 70px;
    --dock-width: 380px;
    --bottom-bar-height: 80px;
    
    /* Border Radius */
    --radius-sm: 6px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 24px;
    
    /* Shadows */
    --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.2);
    --shadow-md: 0 4px 24px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 8px 48px rgba(0, 0, 0, 0.4);
    --shadow-panel: 0 0 60px rgba(0, 0, 0, 0.5);
    
    /* Transitions */
    --transition-fast: 150ms ease;
    --transition-base: 250ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 400ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-bounce: 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
    
    /* Z-Index Scale */
    --z-canvas: 1;
    --z-vignette: 5;
    --z-shadow-catcher: 8;
    --z-ui: 10;
    --z-dock: 20;
    --z-panel: 30;
    --z-header: 40;
    --z-modal: 100;
    --z-toast: 200;
    --z-loading: 1000;
}

/* Reset & Base */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

body {
    font-family: var(--font-body);
    background: var(--bg-primary);
    color: var(--text-primary);
    overflow: hidden;
    line-height: 1.5;
}

/* Typography */
h1, h2, h3, h4 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.2;
}

/* ============================================
   LOADING SCREEN
   ============================================ */
#loading-screen {
    position: fixed;
    inset: 0;
    z-index: var(--z-loading);
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0f1419;
}

.loading-bg-gradient {
    position: absolute;
    inset: 0;
    background: 
        radial-gradient(ellipse 80% 50% at 50% -20%, rgba(245, 166, 35, 0.15), transparent),
        radial-gradient(ellipse 60% 40% at 80% 100%, rgba(79, 195, 247, 0.1), transparent);
    pointer-events: none;
}

.loading-content {
    position: relative;
    text-align: center;
    z-index: 1;
}

.logo-mark {
    width: 80px;
    height: 80px;
    color: var(--accent-solar);
    margin: 0 auto var(--space-md);
    animation: pulse-glow 2s ease-in-out infinite;
}

@keyframes pulse-glow {
    0%, 100% { filter: drop-shadow(0 0 20px var(--accent-solar-glow)); }
    50% { filter: drop-shadow(0 0 40px var(--accent-solar-glow)); }
}

.loading-title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-primary);
}

.loading-subtitle {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: var(--space-xl);
}

.loading-bar {
    width: 200px;
    height: 2px;
    background: var(--bg-tertiary);
    border-radius: 1px;
    margin: 0 auto var(--space-md);
    overflow: hidden;
}

.loading-progress {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--accent-solar), var(--accent-air));
    border-radius: 1px;
    animation: loading-progress 2s ease-in-out infinite;
}

@keyframes loading-progress {
    0% { width: 0%; transform: translateX(-100%); }
    50% { width: 100%; transform: translateX(0); }
    100% { width: 100%; transform: translateX(100%); }
}

.loading-status {
    font-size: 0.75rem;
    color: var(--text-muted);
}

/* ============================================
   MAIN APPLICATION - NEW DOCK LAYOUT
   ============================================ */
#app {
    position: fixed;
    inset: 0;
}

#app.hidden {
    opacity: 0;
    pointer-events: none;
}

#view3d {
    position: fixed;
    inset: 0;
    z-index: var(--z-canvas);
    width: 100vw;
    height: 100vh;
}

/* Vignette - subtle, keeps center clear */
.vignette-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-vignette);
    pointer-events: none;
    background: 
        /* Very subtle corner darkening for panels */
        radial-gradient(ellipse 300px 250px at 0% 0%, transparent 50%, rgba(0, 0, 0, 0.15) 100%),
        radial-gradient(ellipse 300px 250px at 100% 0%, transparent 50%, rgba(0, 0, 0, 0.15) 100%),
        radial-gradient(ellipse 300px 150px at 0% 100%, transparent 40%, rgba(0, 0, 0, 0.2) 100%),
        radial-gradient(ellipse 300px 150px at 100% 100%, transparent 40%, rgba(0, 0, 0, 0.2) 100%),
        /* Center stays very clear - minimal vignette */
        radial-gradient(ellipse 70% 70% at 50% 50%, transparent 60%, rgba(0, 0, 0, 0.1) 100%);
}

/* ============================================
   UI CONTAINER - NO OVERLAPS
   ============================================ */
#ui-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-ui);
    pointer-events: none;
    display: grid;
    grid-template-rows: var(--header-height) 1fr var(--bottom-bar-height);
    grid-template-columns: var(--dock-width) 1fr var(--dock-width);
    grid-template-areas:
        "header header header"
        "left-panel center right-panel"
        "bottom-left center-bottom bottom-right";
    gap: 0;
    padding: var(--space-md);
}

/* Everything in UI can receive pointer events */
#ui-overlay > * {
    pointer-events: auto;
}

/* ============================================
   HEADER - TOP CENTER
   ============================================ */
.app-header {
    grid-area: header;
    place-self: start center;
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    padding: var(--space-sm) var(--space-lg);
    background: var(--bg-glass);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    margin-top: var(--space-sm);
}

.brand {
    display: flex;
    align-items: center;
    gap: var(--space-md);
}

.brand-mark {
    width: 32px;
    height: 32px;
    color: var(--accent-solar);
}

.brand-text h1 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
}

.brand-text span {
    display: block;
    font-size: 0.6rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: -2px;
}

/* Navigation */
.app-nav {
    display: flex;
    gap: var(--space-xs);
}

.nav-btn {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: var(--text-tertiary);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.nav-btn:hover {
    background: var(--bg-glass-light);
    color: var(--text-secondary);
}

.nav-btn.active {
    background: linear-gradient(135deg, rgba(245, 166, 35, 0.15), rgba(245, 166, 35, 0.05));
    border-color: rgba(245, 166, 35, 0.3);
    color: var(--accent-solar);
}

.nav-icon {
    font-size: 1rem;
}

/* ============================================
   DOCK PANELS - SIDES ONLY, NO OVERLAP
   ============================================ */
.dock-panel {
    position: relative;
    background: var(--bg-glass);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-panel);
    overflow: hidden;
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
}

/* Collapsed state - icon only */
.dock-panel.collapsed {
    max-height: 48px;
    min-height: 48px;
    overflow: hidden;
    flex-shrink: 0;
}

.dock-panel.collapsed .panel-content {
    opacity: 0;
    pointer-events: none;
}

/* Panel positioning - LEFT SIDE */
#site-panel {
    grid-area: left-panel;
    place-self: start start;
    width: 100%;
    max-height: calc(100vh - var(--header-height) - var(--space-lg) * 3);
}

#time-panel {
    grid-area: bottom-left;
    place-self: end start;
    width: 100%;
    max-height: 280px;
}

/* Panel positioning - RIGHT SIDE (stacked) */
#metrics-panel {
    grid-area: right-panel;
    place-self: start end;
    width: 100%;
    max-height: calc((100vh - var(--header-height) - var(--bottom-bar-height) - var(--space-lg) * 4) / 2);
    margin-bottom: var(--space-sm);
}

#design-panel {
    grid-area: bottom-right;
    place-self: end end;
    width: 100%;
    max-height: calc((100vh - var(--header-height) - var(--bottom-bar-height) - var(--space-lg) * 4) / 2);
}

/* Panel header */
.panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm) var(--space-md);
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    cursor: pointer;
    flex-shrink: 0;
}

.panel-header h2 {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-secondary);
}

.panel-toggle {
    width: 24px;
    height: 24px;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.5;
    transition: all var(--transition-fast);
    transform: rotate(0deg);
}

.panel-toggle:hover {
    opacity: 1;
}

.dock-panel.collapsed .panel-toggle {
    transform: rotate(-90deg);
}

.panel-toggle svg {
    width: 16px;
    height: 16px;
}

/* Panel content */
.panel-content {
    padding: var(--space-md);
    overflow-y: auto;
    flex: 1;
    transition: opacity var(--transition-fast);
}

.panel-content::-webkit-scrollbar {
    width: 4px;
}

.panel-content::-webkit-scrollbar-track {
    background: transparent;
}

.panel-content::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
}

/* ============================================
   FORM ELEMENTS
   ============================================ */
.field-label {
    display: block;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
}

.search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

#site-search {
    width: 100%;
    padding: var(--space-sm) var(--space-xl) var(--space-sm) var(--space-sm);
    background: var(--bg-glass-light);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.875rem;
    outline: none;
    transition: all var(--transition-fast);
}

#site-search:focus {
    border-color: var(--accent-solar);
    box-shadow: 0 0 0 3px var(--accent-solar-glow);
}

#site-search::placeholder {
    color: var(--text-muted);
}

.icon-btn {
    position: absolute;
    right: var(--space-xs);
    width: 28px;
    height: 28px;
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    color: var(--text-tertiary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
}

.icon-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
}

.icon-btn.large {
    position: static;
    width: 40px;
    height: 40px;
}

.quick-locations {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
}

.chip {
    padding: var(--space-xs) var(--space-sm);
    background: var(--bg-glass-light);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    color: var(--text-tertiary);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.chip:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    color: var(--text-secondary);
}

.info-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    margin: var(--space-md) 0;
}

/* ============================================
   SITE INFO
   ============================================ */
.site-info.hidden {
    display: none;
}

.info-grid {
    display: grid;
    gap: var(--space-sm);
}

.info-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-xs) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}

.info-item:last-child {
    border-bottom: none;
}

.info-label {
    font-size: 0.75rem;
    color: var(--text-tertiary);
}

.info-value {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    font-family: 'SF Mono', monospace;
}

.quality-badge {
    padding: var(--space-xs) var(--space-sm);
    background: rgba(74, 222, 128, 0.15);
    border-radius: var(--radius-sm);
    color: var(--accent-success);
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

/* ============================================
   METRICS SECTIONS
   ============================================ */
.metric-section {
    margin-bottom: var(--space-md);
}

.metric-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
}

.metric-icon {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
}

.solar-icon {
    background: rgba(245, 166, 35, 0.15);
    color: var(--accent-solar);
}

.air-icon {
    background: rgba(79, 195, 247, 0.15);
    color: var(--accent-air);
}

.pollen-icon {
    background: rgba(167, 139, 250, 0.15);
    color: var(--accent-pollen);
}

.metric-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
}

.metric-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
}

.metric-card {
    background: var(--bg-glass-light);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-md);
    padding: var(--space-sm);
    text-align: center;
}

.metric-value {
    display: block;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
    font-family: 'SF Mono', monospace;
}

.metric-unit {
    display: block;
    font-size: 0.5625rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.metric-label {
    display: block;
    font-size: 0.625rem;
    color: var(--text-tertiary);
    margin-top: 2px;
}

.action-btn {
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    background: var(--bg-glass-light);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.action-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--accent-solar);
    color: var(--text-primary);
}

.action-btn.secondary {
    background: transparent;
}

/* ============================================
   AQI DISPLAY
   ============================================ */
.aqi-display {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
}

.aqi-ring {
    position: relative;
    width: 64px;
    height: 64px;
    color: var(--accent-success);
    flex-shrink: 0;
}

.aqi-ring svg {
    transform: rotate(-90deg);
}

.aqi-progress {
    transition: stroke-dashoffset 1s ease;
}

.aqi-value {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.aqi-value span {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1;
}

.aqi-value small {
    font-size: 0.5625rem;
    color: var(--text-muted);
    text-transform: uppercase;
}

.aqi-info {
    flex: 1;
    min-width: 0;
}

.aqi-category {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
}

.aqi-pollutant {
    display: block;
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    margin-top: 2px;
}

.health-recommendation {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-sm);
    background: rgba(79, 195, 247, 0.08);
    border: 1px solid rgba(79, 195, 247, 0.15);
    border-radius: var(--radius-md);
}

.rec-icon {
    font-size: 0.875rem;
    flex-shrink: 0;
}

.rec-text {
    font-size: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.5;
}

/* ============================================
   POLLEN DISPLAY
   ============================================ */
.pollen-types {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
}

.pollen-item {
    display: grid;
    grid-template-columns: 45px 1fr auto;
    align-items: center;
    gap: var(--space-sm);
}

.pollen-name {
    font-size: 0.75rem;
    color: var(--text-secondary);
}

.pollen-bar {
    height: 4px;
    background: var(--bg-glass-light);
    border-radius: 2px;
    overflow: hidden;
}

.pollen-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-pollen), #c4b5fd);
    border-radius: 2px;
    transition: width var(--transition-slow);
}

.pollen-fill.tree {
    background: linear-gradient(90deg, #4ade80, #86efac);
}

.pollen-fill.weed {
    background: linear-gradient(90deg, #fbbf24, #fcd34d);
}

.pollen-level {
    font-size: 0.625rem;
    color: var(--text-muted);
    text-transform: uppercase;
    min-width: 45px;
    text-align: right;
}

/* ============================================
   TIME & SHADOW CONTROLS
   ============================================ */
.time-display {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
}

.time-big {
    font-size: 2rem;
    font-weight: 300;
    font-family: 'SF Mono', monospace;
    color: var(--text-primary);
    line-height: 1;
}

.time-period {
    font-size: 0.875rem;
    color: var(--text-tertiary);
}

.date-display {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.time-slider-container {
    margin-bottom: var(--space-md);
}

.time-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.5625rem;
    color: var(--text-muted);
    margin-bottom: var(--space-xs);
}

#time-slider {
    width: 100%;
    height: 4px;
    background: transparent;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
    position: relative;
    z-index: 2;
}

#time-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 14px;
    height: 14px;
    background: var(--accent-solar);
    border-radius: 50%;
    cursor: grab;
    box-shadow: 0 0 0 3px rgba(245, 166, 35, 0.3);
    margin-top: -5px;
}

#time-slider::-webkit-slider-runnable-track {
    height: 4px;
    background: var(--bg-tertiary);
    border-radius: 2px;
}

.time-track {
    height: 4px;
    background: var(--bg-tertiary);
    border-radius: 2px;
    margin-top: -8px;
    position: relative;
    overflow: hidden;
}

.time-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 50%;
    background: linear-gradient(90deg, var(--accent-solar), #fbbf24);
    border-radius: 2px;
    pointer-events: none;
}

.date-control {
    margin-bottom: var(--space-sm);
}

#date-picker {
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    background: var(--bg-glass-light);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    outline: none;
}

.shadow-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
}

.shadow-stat {
    text-align: center;
    padding: var(--space-sm);
    background: var(--bg-glass-light);
    border-radius: var(--radius-md);
}

.shadow-label {
    display: block;
    font-size: 0.5625rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 2px;
}

.shadow-value {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    font-family: 'SF Mono', monospace;
}

.animation-controls {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
}

/* ============================================
   DESIGN TOOLS
   ============================================ */
.design-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
}

.design-btn {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    padding: var(--space-sm);
    background: var(--bg-glass-light);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: var(--font-body);
    text-align: left;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.design-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
}

.design-btn.primary {
    background: linear-gradient(135deg, rgba(245, 166, 35, 0.2), rgba(245, 166, 35, 0.05));
    border-color: rgba(245, 166, 35, 0.3);
}

.design-btn.primary:hover {
    background: linear-gradient(135deg, rgba(245, 166, 35, 0.3), rgba(245, 166, 35, 0.1));
    border-color: rgba(245, 166, 35, 0.5);
    box-shadow: 0 0 20px rgba(245, 166, 35, 0.15);
}

.btn-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-md);
    font-size: 1rem;
    flex-shrink: 0;
}

.btn-text {
    flex: 1;
    min-width: 0;
}

.btn-title {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
}

.btn-desc {
    display: block;
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    margin-top: 1px;
}

.volume-controls.hidden {
    display: none;
}

.control-group {
    margin-bottom: var(--space-sm);
}

.control-group label {
    display: block;
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-xs);
}

.control-group input[type="range"] {
    width: 100%;
    height: 4px;
    background: var(--bg-tertiary);
    border-radius: 2px;
    -webkit-appearance: none;
    margin-bottom: 2px;
}

.control-group input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    background: var(--accent-solar);
    border-radius: 50%;
    cursor: grab;
}

.control-value {
    display: block;
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-align: right;
    font-family: 'SF Mono', monospace;
}

/* ============================================
   ACTION BAR - BOTTOM CENTER
   ============================================ */
.action-bar {
    grid-area: center-bottom;
    place-self: end center;
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--bg-glass);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    margin-bottom: var(--space-sm);
}

.primary-btn {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-lg);
    background: linear-gradient(135deg, var(--accent-solar), #fbbf24);
    border: none;
    border-radius: var(--radius-xl);
    color: var(--bg-primary);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 24px rgba(245, 166, 35, 0.3);
    transition: all var(--transition-fast);
    white-space: nowrap;
}

.primary-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(245, 166, 35, 0.4);
}

.primary-btn.pulse {
    animation: btn-pulse 2s ease-in-out infinite;
}

@keyframes btn-pulse {
    0%, 100% { box-shadow: 0 4px 24px rgba(245, 166, 35, 0.3); }
    50% { box-shadow: 0 4px 32px rgba(245, 166, 35, 0.5); }
}

.secondary-btn {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: var(--bg-glass-light);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xl);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
}

.secondary-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
}

.layer-toggles {
    display: flex;
    gap: var(--space-xs);
    padding-left: var(--space-md);
    border-left: 1px solid rgba(255, 255, 255, 0.1);
}

.toggle-btn {
    width: 40px;
    height: 40px;
    background: var(--bg-glass-light);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    color: var(--text-tertiary);
    font-size: 1rem;
    cursor: pointer;
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
}

.toggle-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
}

.toggle-btn.active {
    background: rgba(245, 166, 35, 0.15);
    border-color: rgba(245, 166, 35, 0.4);
    color: var(--accent-solar);
}

/* ============================================
   MODAL
   ============================================ */
.modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl);
}

.modal.hidden {
    display: none;
}

.modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
}

.modal-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    max-height: 85vh;
    max-width: 800px;
    width: 100%;
    background: var(--bg-glass);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
}

.modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
}

.modal-title {
    display: flex;
    align-items: center;
    gap: var(--space-md);
}

.modal-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--accent-solar), #fbbf24);
    border-radius: var(--radius-md);
    color: var(--bg-primary);
    font-size: 1.25rem;
    flex-shrink: 0;
}

.modal-title h2 {
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 600;
}

.modal-subtitle {
    display: block;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-top: 2px;
}

.close-btn {
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    border-radius: var(--radius-md);
    color: var(--text-tertiary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
    flex-shrink: 0;
}

.close-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
}

.modal-body {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-lg);
}

/* ============================================
   REPORT CONTENT
   ============================================ */
.report-loading {
    text-align: center;
    padding: var(--space-xl);
}

.loading-spinner {
    width: 40px;
    height: 40px;
    margin: 0 auto var(--space-md);
    border: 2px solid rgba(245, 166, 35, 0.2);
    border-top-color: var(--accent-solar);
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.report-loading p {
    font-size: 1rem;
    color: var(--text-primary);
    margin-bottom: var(--space-xs);
}

.loading-detail {
    font-size: 0.75rem;
    color: var(--text-muted);
}

.report-content {
    line-height: 1.7;
}

.report-content.hidden {
    display: none;
}

.report-content h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--accent-solar);
    margin: var(--space-lg) 0 var(--space-sm);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.report-content h2:first-child {
    margin-top: 0;
}

.report-content h3 {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: var(--space-md) 0 var(--space-xs);
}

.report-content p {
    color: var(--text-secondary);
    margin-bottom: var(--space-sm);
    font-size: 0.875rem;
}

.report-content ul, .report-content ol {
    margin-bottom: var(--space-sm);
    padding-left: var(--space-lg);
}

.report-content li {
    color: var(--text-secondary);
    margin-bottom: var(--space-xs);
    font-size: 0.875rem;
}

.report-content strong {
    color: var(--text-primary);
    font-weight: 600;
}

/* ============================================
   TOAST NOTIFICATIONS
   ============================================ */
#toast-container {
    position: fixed;
    bottom: calc(var(--bottom-bar-height) + var(--space-md));
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--z-toast);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    pointer-events: none;
}

.toast {
    padding: var(--space-sm) var(--space-md);
    background: var(--bg-glass);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xl);
    color: var(--text-primary);
    font-size: 0.875rem;
    box-shadow: var(--shadow-lg);
    animation: toast-in 0.3s ease, toast-out 0.3s ease 4.7s;
    pointer-events: auto;
}

@keyframes toast-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes toast-out {
    to { opacity: 0; transform: translateY(-20px); }
}

.toast.success {
    border-color: rgba(74, 222, 128, 0.3);
    background: rgba(74, 222, 128, 0.1);
}

.toast.error {
    border-color: rgba(248, 113, 113, 0.3);
    background: rgba(248, 113, 113, 0.1);
}

/* ============================================
   PRESENTATION MODE - UI HIDDEN
   ============================================ */
.presentation-mode #ui-overlay > *:not(.toast-container) {
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-slow);
}

.presentation-mode .toast-container {
    opacity: 1;
    pointer-events: auto;
}

.presentation-mode .vignette-overlay {
    opacity: 0.3;
}

/* Exit presentation mode hint */
.presentation-mode::after {
    content: 'Press ESC to exit presentation mode';
    position: fixed;
    bottom: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    padding: var(--space-xs) var(--space-md);
    background: var(--bg-glass);
    border-radius: var(--radius-xl);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    z-index: var(--z-ui);
    opacity: 0;
    animation: fade-in-out 3s ease;
}

@keyframes fade-in-out {
    0%, 100% { opacity: 0; }
    20%, 80% { opacity: 1; }
}

/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 1200px) {
    :root {
        --dock-width: 320px;
    }
}

@media (max-width: 900px) {
    :root {
        --dock-width: 280px;
    }
    
    .app-nav {
        display: none;
    }
    
    .brand-text span {
        display: none;
    }
}

@media (max-width: 700px) {
    #ui-overlay {
        grid-template-columns: 1fr;
        grid-template-areas:
            "header"
            "center"
            "center-bottom";
    }
    
    .dock-panel {
        position: fixed;
        bottom: calc(var(--bottom-bar-height) + var(--space-md));
        left: var(--space-md);
        right: var(--space-md);
        max-height: 50vh;
        z-index: var(--z-panel);
    }
    
    #site-panel,
    #metrics-panel,
    #time-panel,
    #design-panel {
        grid-area: auto;
        place-self: auto;
        display: none;
    }
    
    .dock-panel.active {
        display: flex;
    }
}

/* ============================================
   UTILITY CLASSES
   ============================================ */
.hidden {
    display: none !important;
}

.visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
}
